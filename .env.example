# ── App ──────────────────────────────────────────────────────────────────────
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string
# Generate FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-to-a-fernet-key
APP_ENV=production

# ── Database (SQL Server) ─────────────────────────────────────────────────────
# Docker (production): DB_SERVER=sqlserver
# Local instance:      DB_SERVER=localhost\SQLEXPRESS
#
# SECURITY: In production, create a dedicated service account — never use 'sa'.
#   CREATE LOGIN app_user WITH PASSWORD='<strong-password>';
#   USE TradingBonusHub;
#   CREATE USER app_user FOR LOGIN app_user;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON SCHEMA::dbo TO app_user;
DB_SERVER=sqlserver
DB_NAME=TradingBonusHub
DB_USER=app_user
DB_PASSWORD=change-me-to-a-strong-password
DB_POOL_SIZE=20

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@tradingbonushub.com

# ── Telegram (optional) ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPPORT_USERNAME=@tradingbonushub_support

# ── Google OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
